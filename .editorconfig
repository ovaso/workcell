root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{*.json,*.mjs,*.yaml,*.yml}]
indent_style = space
indent_size = 2

[{*.py,*.toml}]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2

[{*.ps1,*.psm1}]
indent_style = space
indent_size = 4
