{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-standard-workspace:schema:bundle:0.1",
  "title": "Standard Workspace Bootstrap Bundle V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle", "versions", "payload", "safety"],
  "properties": {
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "format"],
      "properties": {
        "id": {"const": "bootstrap-standard-workspace"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "status": {"enum": ["draft", "release-candidate", "stable", "deprecated"]},
        "format": {"const": "text-only-skill-bundle"}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "release_manifest", "environment_facts", "project_plugin", "diagnostic_profile", "task", "feedback_report", "project_plugin_api", "diagnostic_plugin_api"],
      "properties": {
        "workspace": {"const": "0.1"},
        "release_manifest": {"const": "0.1"},
        "environment_facts": {"const": "0.1"},
        "project_plugin": {"const": "0.1"},
        "diagnostic_profile": {"const": "0.1"},
        "task": {"const": "0.1"},
        "feedback_report": {"const": "0.1"},
        "project_plugin_api": {"const": "0.1"},
        "diagnostic_plugin_api": {"const": "0.1"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_asset", "required_entries"],
      "properties": {
        "workspace_asset": {"type": "string", "pattern": "^assets/workspace-v[0-9]+\\.[0-9]+$"},
        "required_entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_default", "install_tools", "modify_shell", "overwrite_non_empty", "self_update"],
      "properties": {
        "network_default": {"const": "deny"},
        "install_tools": {"const": false},
        "modify_shell": {"const": false},
        "overwrite_non_empty": {"const": false},
        "self_update": {"const": false}
      }
    }
  }
}
