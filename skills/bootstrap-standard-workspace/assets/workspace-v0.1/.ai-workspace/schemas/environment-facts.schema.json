{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-standard-workspace:schema:environment-facts:0.1",
  "title": "Host Environment Facts V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot", "facts"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "context", "collector", "network_probe_requested"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["uninitialized", "partial", "verified", "degraded", "stale", "failed"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "context": {"$ref": "#/$defs/context"},
        "collector": {"type": "string", "minLength": 1},
        "network_probe_requested": {"type": "boolean"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "supersedes": {"type": ["string", "null"]}
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "toolchains", "environment_variables", "network"],
      "properties": {
        "commands": {"type": "array", "items": {"$ref": "#/$defs/commandFact"}},
        "toolchains": {"type": "array", "items": {"$ref": "#/$defs/toolchainFact"}},
        "environment_variables": {"type": "array", "items": {"$ref": "#/$defs/environmentVariableFact"}},
        "network": {"type": "array", "items": {"$ref": "#/$defs/networkFact"}}
      }
    }
  },
  "$defs": {
    "context": {
      "enum": ["system", "login-shell", "non-interactive-shell", "ai-execution", "workspace", "project", "task"]
    },
    "commonFact": {
      "type": "object",
      "required": ["id", "kind", "source_type", "source", "observed_at", "context", "confidence", "sensitivity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string"},
        "source_type": {"enum": ["declared", "discovered", "derived", "runtime"]},
        "source": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "context": {"$ref": "#/$defs/context"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "sensitivity": {"enum": ["public", "private", "secret", "unknown"]}
      }
    },
    "commandFact": {
      "allOf": [
        {"$ref": "#/$defs/commonFact"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "source_type", "source", "observed_at", "context", "confidence", "sensitivity", "name", "available", "resolved_path", "version", "version_probe"],
          "properties": {
            "id": {}, "kind": {"const": "command"}, "source_type": {}, "source": {}, "observed_at": {}, "context": {}, "confidence": {}, "sensitivity": {},
            "name": {"type": "string", "minLength": 1},
            "available": {"type": "boolean"},
            "resolved_path": {"type": ["string", "null"]},
            "version": {"type": ["string", "null"]},
            "version_probe": {"enum": ["not-available", "unsupported", "completed", "empty-output", "timeout", "error"]},
            "version_probe_exit_code": {"type": "integer"},
            "version_probe_argv": {"type": "array", "items": {"type": "string"}},
            "version_probe_error": {"type": "string"}
          }
        }
      ]
    },
    "toolchainFact": {
      "allOf": [
        {"$ref": "#/$defs/commonFact"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "source_type", "source", "observed_at", "context", "confidence", "sensitivity", "toolchain", "command", "declared_version", "installed_versions", "current_version", "manager", "scope"],
          "properties": {
            "id": {}, "kind": {"const": "toolchain"}, "source_type": {}, "source": {}, "observed_at": {}, "context": {}, "confidence": {}, "sensitivity": {},
            "toolchain": {"type": "string"},
            "command": {"type": "string"},
            "declared_version": {"type": ["string", "null"]},
            "installed_versions": {"type": "array", "items": {"type": "string"}},
            "current_version": {"type": ["string", "null"]},
            "manager": {"type": "string"},
            "scope": {"type": "string"}
          }
        }
      ]
    },
    "environmentVariableFact": {
      "allOf": [
        {"$ref": "#/$defs/commonFact"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "source_type", "source", "observed_at", "context", "confidence", "sensitivity", "name", "is_set", "value_recorded", "classification_source"],
          "properties": {
            "id": {}, "kind": {"const": "environment-variable"}, "source_type": {}, "source": {}, "observed_at": {}, "context": {}, "confidence": {}, "sensitivity": {},
            "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "is_set": {"type": "boolean"},
            "value_recorded": {"const": false},
            "classification_source": {"type": "string"},
            "fingerprint": {"type": "string"}
          }
        }
      ]
    },
    "networkFact": {
      "allOf": [
        {"$ref": "#/$defs/commonFact"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "source_type", "source", "observed_at", "context", "confidence", "sensitivity", "protocol", "target_reference", "status", "ttl_seconds"],
          "properties": {
            "id": {}, "kind": {"const": "network"}, "source_type": {}, "source": {}, "observed_at": {}, "context": {}, "confidence": {}, "sensitivity": {},
            "protocol": {"enum": ["http", "https", "tcp"]},
            "target_reference": {"type": "string"},
            "status": {"enum": ["declared-not-probed", "reachable", "unreachable", "blocked", "unknown"]},
            "ttl_seconds": {"type": "integer", "minimum": 0},
            "method": {"type": "string"},
            "response_code": {"type": "integer"},
            "connection_result": {"type": "string"},
            "error": {"type": "string"}
          }
        }
      ]
    }
  }
}
