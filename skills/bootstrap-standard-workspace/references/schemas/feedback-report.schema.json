{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-standard-workspace:schema:feedback-report:0.1",
  "title": "Standard Workspace Feedback Report V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback", "collection", "candidates"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "feedback": {"type": "object", "additionalProperties": false, "required": ["id", "workspace_release", "source_fingerprint", "redaction_confirmed", "created_at"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"}, "workspace_release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}, "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "redaction_confirmed": {"const": true}, "created_at": {"type": "string", "format": "date-time"}}},
    "collection": {"type": "object", "additionalProperties": false, "required": ["mode", "authorized_sources"], "properties": {"mode": {"enum": ["manual", "task-close", "periodic"]}, "authorized_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["task-records", "workspace-control-plane", "approved-project-material"]}}}},
    "candidates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "area", "scope", "title", "summary", "confidence", "occurrences", "evidence"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"}, "kind": {"enum": ["constraint", "capability", "specification", "local-practice"]}, "area": {"enum": ["workspace", "task-lifecycle", "facts", "authorization", "diagnostics", "skills", "upgrade"]}, "scope": {"enum": ["local", "project-plugin", "standard-candidate"]}, "title": {"type": "string", "minLength": 1, "maxLength": 160}, "summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "confidence": {"enum": ["observed", "confirmed"]}, "occurrences": {"type": "integer", "minimum": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "summary"], "properties": {"kind": {"enum": ["task", "decision", "doctor", "test", "review", "manual"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 1000}}}}}}}
  }
}
