{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-standard-workspace:schema:task:0.1",
  "title": "Standard Workspace Task V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "scope", "workflow", "gates", "evidence"],
  "properties": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "status", "project_plugin_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
        "display_name": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "type": {"enum": ["requirement", "defect", "diagnostic", "review", "maintenance", "research"]},
        "status": {
          "enum": ["INBOX", "SCOPED", "PLANNED", "READY", "IMPLEMENTING", "VERIFYING", "DEV_FEEDBACK", "TEST_FEEDBACK", "QC_READY", "RELEASE_READY", "DONE", "PAUSED", "ARCHIVED"]
        },
        "project_plugin_ref": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"], "format": "date-time"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit", "verify", "reference", "excluded"],
      "properties": {
        "edit": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "verify": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reference": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "excluded": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_plan", "next_action", "next_gate"],
      "properties": {
        "current_plan": {"type": ["string", "null"]},
        "superseded_plans": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": ["string", "null"]},
        "next_gate": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]}
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["pending", "passed", "failed", "waived", "not-applicable"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "risk_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "environment_snapshot_ref": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "location"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["requirement", "plan", "code", "test", "log", "metric", "trace", "review", "decision", "release"]},
          "location": {"type": "string"},
          "created_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
