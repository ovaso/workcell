{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workcell:schema:project-plugin:0.1",
  "title": "Project Plugin V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin", "repositories", "modules", "workflows", "risk_areas", "knowledge", "capabilities", "facts", "inferences", "policies", "unresolved_questions"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "version", "api_version", "repository_model"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "display_name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "api_version": {"const": "0.1"},
        "repository_model": {"enum": ["single", "monorepo", "multi"]},
        "description": {"type": "string"}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "default_branch"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"$ref": "#/$defs/relativePath"},
          "default_branch": {"type": "string", "minLength": 1},
          "remote_name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "path", "role", "technology_adapters"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "repository": {"$ref": "#/$defs/id"},
          "path": {"$ref": "#/$defs/relativePath"},
          "role": {"enum": ["edit", "verify", "reference"]},
          "technology_adapters": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
          "dependencies": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
          "description": {"type": "string"}
        }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "test", "verify", "review", "release", "rollback", "close"],
      "properties": {
        "build": {"$ref": "#/$defs/workflowList"},
        "test": {"$ref": "#/$defs/workflowList"},
        "verify": {"$ref": "#/$defs/workflowList"},
        "review": {"$ref": "#/$defs/workflowList"},
        "release": {"$ref": "#/$defs/workflowList"},
        "rollback": {"$ref": "#/$defs/workflowList"},
        "close": {"$ref": "#/$defs/workflowList"}
      }
    },
    "risk_areas": {"type": "array", "items": {"$ref": "#/$defs/namedRecord"}},
    "knowledge": {"type": "array", "items": {"$ref": "#/$defs/namedRecord"}},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "fact_refs", "confidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "fact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "source_type"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["user-confirmed", "workspace-policy", "project-config", "project-rule"]},
          "source": {"type": "string"}
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "question": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}},
        {"not": {"pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"}}
      ]
    },
    "workflowList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "working_directory", "argv"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "working_directory": {"$ref": "#/$defs/relativePath"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "description": {"type": "string"}
        }
      }
    },
    "namedRecord": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "source": {"type": "string"},
        "module_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "fact": {
      "type": "object",
      "required": ["id", "kind", "source_type", "source", "observed_at", "context", "confidence", "sensitivity"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["declared", "discovered", "derived", "runtime"]},
        "source": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "context": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["low", "medium", "high"]},
        "sensitivity": {"enum": ["public", "private", "secret", "unknown"]}
      }
    }
  }
}
