{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-standard-workspace:schema:workspace:0.1",
  "title": "Standard Workspace Manifest V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace", "versions", "paths", "safety"],
  "properties": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "managed_by"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "status": {
          "enum": [
            "CREATED",
            "ENVIRONMENT_INITIALIZED",
            "PROJECT_ATTACHED",
            "PROJECT_ADAPTED",
            "DIAGNOSTICS_CONFIGURED",
            "READY",
            "DEGRADED",
            "PAUSED",
            "ARCHIVED"
          ]
        },
        "managed_by": {"const": "ai-native-standard-workspace"},
        "active_environment_snapshot": {"type": ["string", "null"]},
        "project_plugin_ref": {"type": ["string", "null"]},
        "diagnostic_profile_ref": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"], "format": "date-time"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "workspace_schema", "release_manifest_schema", "environment_facts_schema", "project_plugin_schema", "diagnostic_profile_schema", "task_schema", "feedback_report_schema"],
      "properties": {
        "product": {"type": "string"},
        "workspace_schema": {"type": "string"},
        "release_manifest_schema": {"type": "string"},
        "environment_facts_schema": {"type": "string"},
        "project_plugin_schema": {"type": "string"},
        "diagnostic_profile_schema": {"type": "string"},
        "task_schema": {"type": "string"},
        "feedback_report_schema": {"type": "string"}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "required": ["environment", "project", "requirements", "workspaces", "skills", "feedback", "locales"]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_operations_default", "bootstrap_network", "overwrite_non_empty"],
      "properties": {
        "remote_operations_default": {"const": "deny"},
        "bootstrap_network": {"const": "deny"},
        "overwrite_non_empty": {"const": false}
      }
    }
  }
}
