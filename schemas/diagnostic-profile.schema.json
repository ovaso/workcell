{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-standard-workspace:schema:diagnostic-profile:0.1",
  "title": "Project Diagnostic Profile V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "policies", "targets", "providers", "correlations", "authorizations", "facts"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "api_version", "status", "configured_by_interview"],
      "properties": {
        "id": {"type": "string"},
        "api_version": {"const": "0.1"},
        "status": {"enum": ["unconfigured", "configuring", "draft", "verified", "degraded", "stale", "disabled"]},
        "configured_by_interview": {"type": "boolean"},
        "project_id": {"type": ["string", "null"]},
        "configured_at": {"type": ["string", "null"], "format": "date-time"},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_action", "remote_shell", "remote_write", "credential_output", "unknown_target"],
      "properties": {
        "default_action": {"const": "deny"},
        "remote_shell": {"enum": ["deny", "ask", "allow"]},
        "remote_write": {"enum": ["deny", "ask", "allow"]},
        "credential_output": {"const": "deny"},
        "unknown_target": {"const": "deny"},
        "production_access": {"enum": ["deny", "ask", "allow-read-only"]},
        "secret_values_allowed": {"const": false},
        "allowed_collection_modes": {
          "type": "array",
          "items": {"enum": ["local-read", "local-process-inspect", "file-copy-read-only", "api-read-only", "observability-query", "remote-command-read-only"]},
          "uniqueItems": true
        },
        "forbidden_actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "environment", "fact_status"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "enum": ["local-cli", "desktop-app", "local-process", "library", "batch-job", "baremetal-service", "container", "kubernetes", "distributed-system", "observability-backed", "hybrid"]
          },
          "environment": {"type": "string"},
          "fact_status": {"enum": ["declared", "code-verified", "endpoint-verified", "runtime-observed", "stale"]},
          "endpoint_refs": {"type": "array", "items": {"type": "string"}},
          "log_locations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "enabled", "authorization"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["local-files", "local-process", "file-transfer", "remote-command", "container-runtime", "kubernetes-api", "logs-api", "metrics-api", "traces-api", "custom"]},
          "enabled": {"type": "boolean"},
          "authorization": {"enum": ["denied", "read-only", "ask-each-time", "task-scoped"]},
          "target_refs": {"type": "array", "items": {"type": "string"}},
          "credential_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^(?:env|keychain|file-ref|vault|secret-ref)://"}
          }
        }
      }
    },
    "correlations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sources"],
        "properties": {
          "name": {"type": "string"},
          "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "sensitive": {"type": "boolean"}
        }
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "target_refs", "environments", "mode", "source", "confirmed_at"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "target_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "environments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "mode": {"enum": ["denied", "read-only", "ask-each-time", "task-scoped"]},
          "source": {"enum": ["user-confirmed", "project-policy", "task-authorization"]},
          "confirmed_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_type", "source", "observed_at", "confidence", "sensitivity"],
        "properties": {
          "id": {"type": "string"},
          "source_type": {"enum": ["user-declared", "code-discovered", "config-discovered", "endpoint-verified", "runtime-observed", "historical"]},
          "source": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"},
          "confidence": {"enum": ["low", "medium", "high"]},
          "sensitivity": {"enum": ["public", "private", "secret", "unknown"]},
          "expires_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "retention": {
      "type": "object",
      "properties": {
        "evidence_directory": {"type": "string"},
        "retention_days": {"type": ["integer", "null"], "minimum": 0},
        "redaction_required": {"type": "boolean"}
      }
    }
  }
}
