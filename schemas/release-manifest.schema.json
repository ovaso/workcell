{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-native-standard-workspace:schema:release-manifest:0.1",
  "title": "Standard Workspace Installed Release Manifest V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_version", "files"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "release_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*//)(?!.*\\/\\.\\.?(?:\\/|$)).+$",
            "not": {"const": ".ai-workspace/release-manifest.json"}
          },
          "owner": {"enum": ["distribution", "generated", "workspace"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
